# Banco
DATABASE_URL=postgresql+psycopg://verzel:verzel@localhost:5432/verzel_ingressos

# Autenticacao
JWT_SECRET=troque-este-valor
JWT_EXPIRES_MINUTES=480

# Assinatura do ingresso (segredo separado do JWT de proposito)
TICKET_SECRET=troque-este-valor-tambem

# Catalogo externo: "tmdb" ou "fixture"
CATALOG_PROVIDER=tmdb
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=pt-BR
TMDB_READ_TOKEN=
CATALOG_CACHE_TTL=600

# Front
CORS_ORIGINS=http://localhost:5173
